{
  "name": "lotivity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local Activities. At a Price Best for You. — mock PWA (v0)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
